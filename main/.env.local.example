# Copy this file to .env.local and fill in the keys.
# These are read only by the /api/chat server route (api/chat.ts); they never reach the browser.
# Comma-separate several keys per provider; the server tries them in turn.

GROQ_API_KEYS=        # https://console.groq.com/keys
GEMINI_API_KEYS=      # https://aistudio.google.com/apikey
MISTRAL_API_KEYS=     # https://console.mistral.ai/api-keys

# Without keys the app still runs: users paste their own key in the "AI engine" step.
# Supabase needs no configuration: the central project is pinned in src/lib/supabase.ts
